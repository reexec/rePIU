# rePIU built-in post-processing shader anime4k (issue #90): Anime4K v3.2 Upscale
# CNN x2 (S) by bloc97 (MIT; each file carries the notice). Four small
# convolution layers at the game's size write signed features into float
# targets, the last pass adds the luma detail they predict to the picture
# scaled 2x, and rePIU scales that to the window. OrigTexture is read with
# pass 0's filter, linear here, as mpv samples MAIN.

shaders = 5

shader0 = conv0.glsl
filter_linear0 = true
scale_type0 = source
scale0 = 1.0
float_framebuffer0 = true

shader1 = conv1.glsl
filter_linear1 = false
scale_type1 = source
scale1 = 1.0
float_framebuffer1 = true

shader2 = conv2.glsl
filter_linear2 = false
scale_type2 = source
scale2 = 1.0
float_framebuffer2 = true

shader3 = conv3.glsl
filter_linear3 = false
scale_type3 = source
scale3 = 1.0
float_framebuffer3 = true

shader4 = depth-to-space.glsl
filter_linear4 = false
scale_type4 = source
scale4 = 2.0
